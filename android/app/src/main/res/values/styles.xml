<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- HexTV is dark all the way to the screen edges: the window shows behind the status and
         navigation bars, so it's the app's black, never the default white. -->
    <color name="hx_black">#050507</color>
    <color name="colorPrimary">#050507</color>
    <color name="colorPrimaryDark">#050507</color>
    <color name="colorAccent">#E50914</color>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/hx_black</item>
        <item name="android:statusBarColor">@color/hx_black</item>
        <item name="android:navigationBarColor">@color/hx_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/hx_black</item>
        <item name="android:statusBarColor">@color/hx_black</item>
        <item name="android:navigationBarColor">@color/hx_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
